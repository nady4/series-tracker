# --- Database ---
# Local development: plain file. On Vercel use a Turso URL (SQLite-compatible):
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-token
DATABASE_URL=file:./data.db

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# Needed for local HTTP dev
AUTH_TRUST_HOST=true

# --- Cron protection (required) ---
# Vercel automatically sends this as a Bearer token to cron routes when set.
CRON_SECRET=change-me

# --- Encryption of users' BYOK keys (AES-256-GCM) ---
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me

# --- Fallback LLM key (used for users without their own key) ---
# Any OpenAI-compatible API key. If left empty, users without a BYOK key
# cannot get news results.
FALLBACK_LLM_API_KEY=
# Optional: base URL for compatible providers (OpenRouter, Groq, Ollama, ...)
FALLBACK_LLM_BASE_URL=
# Optional: model name (defaults to gpt-4o-mini)
FALLBACK_LLM_MODEL=
